# Copy to .env and fill in. Never commit .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Generate with: openssl rand -hex 32
SECRET_KEY=
# First admin account (created only when the database has no users).
# The admin must change this password at first sign-in. You can remove it from .env afterwards.
ADMIN_EMAIL=you@yantralive.com
ADMIN_PASSWORD=
ADMIN_NAME=CTO
# Day 1 of the 30/60/90-day roadmap; seeded due dates count from here.
PROGRAM_START_DATE=2026-11-11
# Keep true behind HTTPS. Set false only to try it locally over plain http.
COOKIE_SECURE=true
WEB_PORT=8080
